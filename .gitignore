# Lake build artifacts
/.lake/
lake-manifest.json.lock
*.olean
*.ilean
# Lean emits C under .lake/ (ignored above). Keep this pattern scoped to that
# tree so hand-written C under fuzz/ is not silently dropped by `git add`.
/.lake/**/*.c

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Bench / conformance scratch outputs (corpora are vendored explicitly)
bench/out/
conformance/out/
bench/corpus/
bench/real_data/
bench/real_out/

# Scratch files from the README libFLAC cross-check walkthrough
/*.flac
/*.pcm

# Fuzzer artifacts if a target is run with the repo root as CWD (e.g. an agent
# invoking fuzz/build/bin/* from here). Their real home + .gitignore is fuzz/;
# these guard the root so an ad-hoc run cannot leave a committable artifact.
/divergences/
/crash-*
/leak-*
/oom-*
/timeout-*
/slow-unit-*

# Python bytecode from the bench scripts
__pycache__/
